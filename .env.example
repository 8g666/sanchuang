DOCGUARD_APP_NAME=DocGuard-RAG
DOCGUARD_APP_VERSION=0.6.0
DOCGUARD_ENVIRONMENT=development
DOCGUARD_DEBUG=false
DOCGUARD_DATABASE_URL=sqlite:///./docguard.db
DOCGUARD_UPLOAD_DIR=uploads
DOCGUARD_MAX_UPLOAD_SIZE=20971520
DOCGUARD_ALLOWED_FILE_TYPES=txt,md,markdown,html,htm,docx,pptx,pdf,png,jpg,jpeg,tif,tiff,bmp,webp
DOCGUARD_OCR_LANG=chi_sim+eng
DOCGUARD_OCR_CONFIG=
DOCGUARD_OCR_TESSERACT_CMD=
DOCGUARD_CHUNK_SIZE=500
DOCGUARD_CHUNK_OVERLAP=100
DOCGUARD_EMBEDDING_DIMENSION=128
DOCGUARD_EMBEDDING_BATCH_SIZE=64
DOCGUARD_EMBEDDING_QUERY_CACHE_SIZE=1024
DOCGUARD_VECTOR_STORE_PROVIDER=local
DOCGUARD_QDRANT_URL=http://127.0.0.1:6333
DOCGUARD_QDRANT_API_KEY=
DOCGUARD_QDRANT_COLLECTION=docguard_chunks
DOCGUARD_QDRANT_TIMEOUT=30
DOCGUARD_EMBEDDING_PROVIDER=hash
DOCGUARD_EMBEDDING_BASE_URL=
DOCGUARD_EMBEDDING_API_KEY=
DOCGUARD_EMBEDDING_MODEL_NAME=
DOCGUARD_RERANKER_ENABLED=true
DOCGUARD_RERANKER_PROVIDER=overlap
DOCGUARD_RERANKER_BASE_URL=
DOCGUARD_RERANKER_API_KEY=
DOCGUARD_RERANKER_MODEL_NAME=
DOCGUARD_LLM_PROVIDER=extractive
DOCGUARD_LLM_BASE_URL=
DOCGUARD_LLM_API_KEY=
DOCGUARD_LLM_MODEL_NAME=
# true 时发 response_format=json_schema（OpenAI 的扩展）；false 时降级成 json_object，
# 并把 schema 写进提示词。智谱只接受 text 和 json_object，所以对智谱必须留 false。
DOCGUARD_LLM_JSON_SCHEMA=false
DOCGUARD_LLM_REVIEW_ENABLED=false

# --- 智谱 GLM（OpenAI 兼容端点）---
# 取消注释即可切到真实语义模型。以下四项必须一起改：
# DIMENSION 是 embedding-3 的输出宽度（可选 256-2048，默认 2048），
# 与 MODEL_NAME 不匹配会导致每次入库都抛 ProviderError。
# 切换 embedding 模型后必须重嵌入语料，见 README「重嵌入」。
#DOCGUARD_EMBEDDING_PROVIDER=compatible_api
#DOCGUARD_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#DOCGUARD_EMBEDDING_API_KEY=<your-key>
#DOCGUARD_EMBEDDING_MODEL_NAME=embedding-3
#DOCGUARD_EMBEDDING_DIMENSION=2048
#
#DOCGUARD_RERANKER_PROVIDER=compatible_api
#DOCGUARD_RERANKER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#DOCGUARD_RERANKER_API_KEY=<your-key>
#DOCGUARD_RERANKER_MODEL_NAME=rerank
#
#DOCGUARD_LLM_PROVIDER=compatible_api
#DOCGUARD_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#DOCGUARD_LLM_API_KEY=<your-key>
# 文本模型可选 glm-4.6、glm-4.7、glm-5.x；glm-4.7-flash 和 glm-4-flash-250414 有免费额度
#DOCGUARD_LLM_MODEL_NAME=glm-4.6
# 智谱只接受 text 和 json_object，这一项必须留 false（默认值）。设成 true 会让查询改写、
# 证据打分、答案校验三个环节收到 400 后静默退回确定性算法——不报错，但等于没接模型。
#DOCGUARD_LLM_JSON_SCHEMA=false

DOCGUARD_TYPO_CONFUSION_JSON={}
DOCGUARD_CORRECTIVE_RAG_ENABLED=true
DOCGUARD_CORRECTIVE_USE_LLM=true
DOCGUARD_CORRECTIVE_MAX_RETRIES=1
DOCGUARD_CORRECTIVE_CANDIDATE_MULTIPLIER=2
DOCGUARD_CORRECTIVE_MIN_RELEVANCE=0.12
DOCGUARD_CORRECTIVE_MIN_EVIDENCE=0.12
DOCGUARD_CORRECTIVE_MIN_VERIFICATION=0.6
DOCGUARD_CORRECTIVE_ABSTENTION_MESSAGE=文档中未找到足够且可验证的依据。
DOCGUARD_AUTH_ENABLED=false
DOCGUARD_API_KEYS_JSON={}
DOCGUARD_DEFAULT_TENANT_ID=default
DOCGUARD_SUPPORT_HISTORY_LIMIT=20
DOCGUARD_TASK_WORKERS=2
DOCGUARD_TASK_BACKEND=local
DOCGUARD_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DOCGUARD_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
DOCGUARD_CELERY_TASK_MAX_RETRIES=3
DOCGUARD_CELERY_TASK_RETRY_DELAY=5
