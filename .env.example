DOCGUARD_QDRANT_TIMEOUT=30
DOCGUARD_EMBEDDING_PROVIDER=hash
DOCGUARD_EMBEDDING_BASE_URL=
DOCGUARD_EMBEDDING_API_KEY=
DOCGUARD_EMBEDDING_MODEL_NAME=
DOCGUARD_RERANKER_ENABLED=true
